{
    "version": 2,
    "git": {
        "deploymentEnabled": {
            "main": true,
            "**": false
        }
    },
    "builds": [
        {
            "src": "src/index.ts",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "src/index.ts"
        }
    ]
}
